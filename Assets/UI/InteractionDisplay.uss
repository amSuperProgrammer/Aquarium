.center-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
}

.cursor-dot {
    width: 6px;
    height: 6px;
    background-color: #ffffff;
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.6);
    display: flex;
}

.interaction-text {
    color: #ffffff;
    font-size: 16px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    display: none;
}
